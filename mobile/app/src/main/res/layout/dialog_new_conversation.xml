<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/messages_new_conversation_title"
        android:textColor="@color/property_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/messages_new_conversation_prompt"
        android:textColor="@color/property_text_secondary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etConversationMessage"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_input_rounded"
        android:gravity="top|start"
        android:hint="@string/messages_new_conversation_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="6"
        android:minLines="3"
        android:padding="14dp"
        android:textColor="@color/property_text_primary"
        android:textColorHint="@color/property_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvConversationError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/messages_message_required"
        android:textColor="@color/property_red"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelConversation"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_outline"
            android:minWidth="96dp"
            android:paddingHorizontal="14dp"
            android:text="@android:string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/property_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCreateConversation"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_button_primary"
            android:minWidth="150dp"
            android:paddingHorizontal="14dp"
            android:text="@string/messages_new_conversation"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
