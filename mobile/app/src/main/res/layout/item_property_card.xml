<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_card_rounded"
    android:elevation="3dp"
    android:orientation="vertical"
    android:paddingBottom="14dp"
    tools:ignore="UseCompatLoadingForDrawables">

    <FrameLayout
        android:id="@+id/layoutImageContainer"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="@drawable/bg_card_image_top"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/ivCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/property_image"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_property_image_placeholder" />

        <TextView
            android:id="@+id/tvPromoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_property_promo_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="@string/ongoing_promo"
            android:textColor="@color/property_blue"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_favorite_circle"
            android:contentDescription="@string/favorite_add_to_favorites"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_favorite_border" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/property_blue"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="PHP 8,500,000" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/property_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="The Alcoves at Cebu Business Park" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/property_text_secondary"
            android:textSize="13sp"
            tools:text="Cebu City" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/property_border" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/property_text_secondary"
            android:textSize="13sp"
            tools:text="High-end condo beside Ayala Center Cebu with hotel-like amenities." />

        <LinearLayout
            android:id="@+id/llListingTypes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />
    </LinearLayout>

</LinearLayout>
