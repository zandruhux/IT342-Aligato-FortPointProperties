<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FortPointProperties"
        tools:targetApi="31">
        <activity
            android:name=".features.article.ui.ArticleDetailActivity"
            android:exported="false" />
        <activity
            android:name=".features.messaging.ui.ConversationDetailActivity"
            android:exported="false" />
        <activity
            android:name=".features.messaging.ui.ConversationsActivity"
            android:exported="false" />
        <activity
            android:name=".features.article.ui.ArticleListActivity"
            android:exported="false" />
        <activity
            android:name=".features.careerApplication.ui.CareerApplicationActivity"
            android:exported="false" />
        <activity
            android:name=".features.favorites.ui.FavoritesActivity"
            android:exported="false" />
        <activity
            android:name=".features.auth.ui.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".features.properties.ui.PropertyDetailActivity"
            android:exported="false" />
        <activity
            android:name=".features.properties.ui.PropertyListActivity"
            android:exported="false" />
        <activity
            android:name=".features.auth.ui.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".features.auth.ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
