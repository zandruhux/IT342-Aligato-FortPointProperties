<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- Generated / build output -->
    <suppress files="[\\/]target[\\/]" checks=".*"/>
    <!-- Spring Boot entry point needs a public constructor for the framework -->
    <suppress files="FortpointpropertiesApplication\.java" checks="HideUtilityClassConstructor"/>
    <!-- ArchUnit rules are declared as static final fields named like tests -->
    <suppress files="ArchitectureTest\.java" checks="ConstantName"/>
</suppressions>
