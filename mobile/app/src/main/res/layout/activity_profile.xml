<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/property_background"
    tools:context=".features.auth.ui.ProfileActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back"
                    android:padding="6dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/property_text_primary" />

                <TextView
                    android:id="@+id/tvProfilePageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/profile_title"
                    android:textColor="@color/property_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_gravity="center_horizontal">

                        <ImageView
                            android:id="@+id/ivProfileAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_avatar_circle"
                            android:contentDescription="@string/profile_avatar"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvProfileAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_avatar_circle"
                            android:gravity="center"
                            android:text="U"
                            android:textColor="@color/property_blue"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnChangePhoto"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_avatar_action_circle"
                            android:contentDescription="@string/profile_change_photo"
                            android:padding="4dp"
                            android:src="@drawable/ic_add"
                            android:tint="@color/property_blue"
                            android:visibility="gone" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Registered User"
                    android:textColor="@color/property_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileHelper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/property_text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/tvAvatarError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/property_red"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Unsupported image type. Please upload JPG, PNG, or WEBP." />

                <TextView
                    android:id="@+id/tvProfileFormError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/property_red"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Please review the highlighted fields." />

                <Button
                    android:id="@+id/btnRemovePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:padding="5dp"
                    android:background="@drawable/bg_button_outline_danger"
                    android:text="@string/profile_remove_photo"
                    android:textAllCaps="false"
                    android:textColor="@color/property_red"
                    android:visibility="gone" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressSaving"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_rounded"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile details"
                    android:textColor="@color/property_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/profile_first_name"
                            android:src="@drawable/ic_profile_user"
                            android:tint="@color/property_blue" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_first_name"
                                android:textColor="@color/property_text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvFirstNameValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/property_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="Zander" />

                            <EditText
                                android:id="@+id/etFirstNameValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/edit_text_background"
                                android:hint="@string/profile_first_name"
                                android:inputType="textPersonName"
                                android:padding="12dp"
                                android:textColor="@color/property_text_primary"
                                android:textColorHint="@color/property_text_secondary"
                                android:textSize="14sp"
                                android:visibility="gone"
                                tools:text="Zander" />

                            <TextView
                                android:id="@+id/tvFirstNameError"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/property_red"
                                android:textSize="12sp"
                                android:visibility="gone"
                                tools:text="First name is required." />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/property_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/profile_last_name"
                            android:src="@drawable/ic_profile_user"
                            android:tint="@color/property_blue" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_last_name"
                                android:textColor="@color/property_text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvLastNameValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/property_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="Aligato" />

                            <EditText
                                android:id="@+id/etLastNameValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/edit_text_background"
                                android:hint="@string/profile_last_name"
                                android:inputType="textPersonName"
                                android:padding="12dp"
                                android:textColor="@color/property_text_primary"
                                android:textColorHint="@color/property_text_secondary"
                                android:textSize="14sp"
                                android:visibility="gone"
                                tools:text="Aligato" />

                            <TextView
                                android:id="@+id/tvLastNameError"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/property_red"
                                android:textSize="12sp"
                                android:visibility="gone"
                                tools:text="Last name is required." />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/property_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/profile_email"
                            android:src="@drawable/ic_profile_email"
                            android:tint="@color/property_blue" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_email"
                                android:textColor="@color/property_text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvEmailValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/property_text_primary"
                                android:textSize="14sp"
                                tools:text="user@example.com" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/property_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/profile_phone"
                            android:src="@drawable/ic_profile_phone"
                            android:tint="@color/property_blue" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_phone"
                                android:textColor="@color/property_text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPhoneValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/property_text_primary"
                                android:textSize="14sp"
                                tools:text="+63 912 345 6789" />

                            <EditText
                                android:id="@+id/etPhoneValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/edit_text_background"
                                android:hint="@string/profile_phone"
                                android:inputType="phone"
                                android:padding="12dp"
                                android:textColor="@color/property_text_primary"
                                android:textColorHint="@color/property_text_secondary"
                                android:textSize="14sp"
                                android:visibility="gone"
                                tools:text="+63 912 345 6789" />

                            <TextView
                                android:id="@+id/tvPhoneError"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/property_red"
                                android:textSize="12sp"
                                android:visibility="gone"
                                tools:text="Please enter a valid phone number." />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/property_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/profile_role"
                            android:src="@drawable/ic_profile_role"
                            android:tint="@color/property_blue" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_role"
                                android:textColor="@color/property_text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRoleValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/property_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="User" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnPrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/profile_edit"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnCancelEdit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_outline"
                android:text="@string/profile_cancel"
                android:textAllCaps="false"
                android:textColor="@color/property_blue"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_danger"
                android:text="@string/profile_logout"
                android:textAllCaps="false"
                android:textColor="@color/white" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
